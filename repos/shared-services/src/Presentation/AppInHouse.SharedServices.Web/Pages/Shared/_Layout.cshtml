@using Microsoft.AspNetCore.Hosting
@inject IWebHostEnvironment Environment
@inject AppInHouse.SharedServices.Web.PortalAuthenticationOptions Authentication
@{
    // Pages for people who are not (yet) allowed in (sign-in, access denied) have no menu: its links would only lead to a refusal.
    var bare = ViewData["Bare"] is true;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var displayName = User.FindFirst("name")?.Value ?? User.Identity?.Name ?? "Quản trị viên";
    var displayEmail = User.FindFirst("email")?.Value ?? (signedIn ? "admin@appinhouse.internal" : string.Empty);
    var roleName = User.FindFirst("role")?.Value ?? "GlobalAdmin";

    // Initials for avatar
    var initials = "QT";
    if (!string.IsNullOrWhiteSpace(displayName))
    {
        var parts = displayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            initials = $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
        }
        else if (parts.Length == 1 && parts[0].Length >= 2)
        {
            initials = parts[0][..2].ToUpperInvariant();
        }
    }

    var page = (string?)ViewContext.RouteData.Values["page"] ?? string.Empty;
    var channel = Context.Request.Query["channel"].ToString();
    string Lit(bool on) => on ? "active" : string.Empty;
    var onConfigurations = page.StartsWith("/Configurations", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Shared Services Hub") · AppInHouse Platform</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <header class="topbar navbar navbar-dark px-3">
        @if (!bare)
        {
            <button class="btn btn-outline-light btn-sm d-lg-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar" aria-label="Mở menu">
                <i class="bi bi-list"></i>
            </button>
        }
        
        <a class="navbar-brand me-3" href="/">
            <div class="brand-icon">
                <i class="bi bi-grid-1x2-fill"></i>
            </div>
            <div>
                <span>AppInHouse</span>
                <span class="text-white-50 ms-1 fw-normal d-none d-sm-inline">Shared Services Hub</span>
            </div>
        </a>

        @if (!bare)
        {
            <!-- Project Switcher Dropdown -->
            <div class="project-switcher dropdown d-none d-md-block me-3">
                <button class="btn dropdown-toggle d-flex align-items-center gap-2" type="button" id="projectSwitcherDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-folder-check text-primary"></i>
                    <span>Tất cả dự án</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="projectSwitcherDropdown">
                    <li><h6 class="dropdown-header text-uppercase">Chọn không gian làm việc</h6></li>
                    <li><a class="dropdown-item active d-flex align-items-center justify-content-between" href="#"><i class="bi bi-check2 me-2"></i>Tất cả dự án <span class="badge bg-primary rounded-pill">Toàn hệ thống</span></a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="?project=identity"><i class="bi bi-shield-lock me-2 text-info"></i>Identity Platform</a></li>
                    <li><a class="dropdown-item" href="?project=linguabridge"><i class="bi bi-translate me-2 text-success"></i>LinguaBridge</a></li>
                    <li><a class="dropdown-item" href="?project=crm"><i class="bi bi-people me-2 text-warning"></i>CRM Internal</a></li>
                    <li><a class="dropdown-item" href="?project=default"><i class="bi bi-box me-2 text-secondary"></i>Default Core</a></li>
                </ul>
            </div>
        }

        <div class="ms-auto d-flex align-items-center gap-2 gap-md-3">
            <!-- Global Health Status Pill -->
            <div class="hero-status-pill d-none d-lg-inline-flex">
                <span class="pulse-dot"></span>
                <span>8/8 Services Hoạt động</span>
            </div>

            @if (Environment.IsDevelopment())
            {
                <span class="badge text-bg-warning d-none d-sm-inline">Dev</span>
            }

            @if (!Authentication.Enabled)
            {
                <span class="badge text-bg-secondary d-none d-xl-inline" id="auth-disabled-badge" title="Chế độ phát triển nội bộ">Bỏ qua Auth</span>
            }

            @if (!bare)
            {
                <!-- Notification Bell Dropdown -->
                <div class="notification-bell dropdown">
                    <button class="btn" type="button" id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo hệ thống">
                        <i class="bi bi-bell"></i>
                        <span class="notification-badge"></span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow p-2" aria-labelledby="notificationDropdown" style="min-width: 300px;">
                        <li><h6 class="dropdown-header d-flex justify-content-between align-items-center">Thông báo dịch vụ <span class="badge bg-success">Hệ thống ổn định</span></h6></li>
                        <li><hr class="dropdown-divider"></li>
                        <li class="px-2 py-1">
                            <div class="small fw-semibold text-dark"><i class="bi bi-check-circle-fill text-success me-1"></i>Hệ thống Multi-Services</div>
                            <div class="text-muted small">8 dịch vụ nền tảng đã sẵn sàng phục vụ các ứng dụng con.</div>
                            <div class="text-muted smaller" style="font-size: 0.72rem;">Vừa xong</div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li class="px-2 py-1">
                            <div class="small fw-semibold text-dark"><i class="bi bi-shield-check text-primary me-1"></i>Bảo mật SSO Identity</div>
                            <div class="text-muted small">Đã đồng bộ thông tin phiên làm việc từ Identity Platform.</div>
                            <div class="text-muted smaller" style="font-size: 0.72rem;">5 phút trước</div>
                        </li>
                    </ul>
                </div>
            }

            @if (signedIn || !Authentication.Enabled)
            {
                <div class="user-profile-badge" id="current-user">
                    <div class="user-avatar-circle">
                        @initials
                    </div>
                    <div class="d-none d-md-flex flex-column text-start lh-1">
                        <span class="text-white fw-semibold small" id="current-user-name">@displayName</span>
                        <div class="d-flex align-items-center gap-1 mt-1">
                            <span class="role-badge">@roleName</span>
                            @if (!string.IsNullOrEmpty(displayEmail))
                            {
                                <span class="text-white-50" style="font-size: 0.7rem;" id="current-user-email">@displayEmail</span>
                            }
                        </div>
                    </div>
                    @if (Authentication.Enabled)
                    {
                        <form method="post" asp-page="/Account/Logout" class="d-inline m-0 ms-1">
                            <button type="submit" class="btn btn-sm btn-link text-white-50 p-0 text-decoration-none" id="logout-button" title="Đăng xuất"><i class="bi bi-box-arrow-right fs-6"></i></button>
                        </form>
                    }
                </div>
            }
        </div>
    </header>

    <div class="shell">
        @if (!bare)
        {
        <nav id="sidebar" class="sidebar offcanvas-lg offcanvas-start" tabindex="-1" aria-label="Menu quản trị">
            <div class="offcanvas-header d-lg-none border-bottom border-secondary border-opacity-25 pb-2">
                <div class="d-flex align-items-center">
                    <div class="brand-icon me-2">
                        <i class="bi bi-grid-1x2-fill"></i>
                    </div>
                    <h5 class="offcanvas-title text-white mb-0 fs-6">Shared Services Hub</h5>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#sidebar" aria-label="Đóng"></button>
            </div>
            
            <div class="offcanvas-body sidebar-content p-0">
                <ul class="nav flex-column w-100">
                    <!-- Tổng quan -->
                    <li class="nav-section">Tổng quan</li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(page == "/Index" || page == "/")" href="/">
                            <i class="bi bi-speedometer2 text-primary"></i>
                            <span class="label">Bảng điều khiển<small>Launchpad 8 dịch vụ</small></span>
                        </a>
                    </li>

                    <!-- Truyền thông & Tin nhắn -->
                    <li class="nav-section">Truyền thông &amp; Tin nhắn</li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(page == "/Email")" asp-page="/Email">
                            <i class="bi bi-envelope-at text-info"></i>
                            <span class="label">Cấu hình Email<small>SMTP · SendGrid · Brevo</small></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(page == "/Chat")" asp-page="/Chat">
                            <i class="bi bi-chat-dots text-info"></i>
                            <span class="label">Tin Nhắn &amp; Chat<small>Telegram · Discord · Slack</small></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(page.StartsWith("/Notifications"))" asp-page="/Notifications/Index">
                            <i class="bi bi-bell text-danger"></i>
                            <span class="label">Notification Hub<small>Đa kênh · Smart Routing</small></span>
                        </a>
                    </li>

                    <!-- Dữ liệu & Lưu trữ -->
                    <li class="nav-section">Dữ liệu &amp; Lưu trữ</li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(page == "/Storage")" asp-page="/Storage">
                            <i class="bi bi-images" style="color: #a855f7;"></i>
                            <span class="label">Lưu trữ &amp; Media Browser</span>
                        </a>
                    </li>

                    <!-- Quản trị & Truy cập -->
                    <li class="nav-section">Quản trị</li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(page.StartsWith("/Projects"))" asp-page="/Projects/Index">
                            <i class="bi bi-folder2-open text-warning"></i>
                            <span class="label">Dự án &amp; Định danh<small>Identity · LinguaBridge · Quotas</small></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(page == "/ApiKeys")" asp-page="/ApiKeys">
                            <i class="bi bi-key text-warning"></i>
                            <span class="label">Ứng dụng &amp; API Keys</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(page.StartsWith("/Webhooks"))" asp-page="/Webhooks/Index">
                            <i class="bi bi-arrow-left-right" style="color: #14b8a6;"></i>
                            <span class="label">Webhook &amp; Tích hợp<small>Inbound · Subscriptions · HMAC</small></span>
                        </a>
                    </li>

                    <!-- Vận hành & Giám sát -->
                    <li class="nav-section">Vận hành &amp; Giám sát</li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(page.StartsWith("/Jobs"))" asp-page="/Jobs/Index">
                            <i class="bi bi-cpu text-success"></i>
                            <span class="label">Background Jobs<small>Queues · Cron · Outbox</small></span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(page == "/Audit")" asp-page="/Audit">
                            <i class="bi bi-journal-text text-primary"></i>
                            <span class="label">Audit Logs &amp; Lịch sử gửi tin</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @Lit(onConfigurations && channel == string.Empty)" asp-page="/Configurations/Index">
                            <i class="bi bi-sliders text-secondary"></i>
                            <span class="label">Tất cả cấu hình<small>Quản lý đa phiên bản</small></span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="sidebar-footer d-none d-lg-block">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-white-50">AppInHouse Hub</span>
                    <span class="badge bg-secondary">v2.0.0</span>
                </div>
                <div class="text-muted small">Multi-Services Architecture</div>
            </div>
        </nav>
        }

        <main class="content" role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
