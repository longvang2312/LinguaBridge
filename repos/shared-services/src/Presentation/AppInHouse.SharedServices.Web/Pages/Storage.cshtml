@page
@model AppInHouse.SharedServices.Web.Pages.StorageModel
@{
    ViewData["Title"] = "Lưu trữ & Media Browser";
    var provider = Model.Form.ProviderType;
    string Hidden(string name) => provider == name ? string.Empty : "d-none";
    var mediaOpen = Model.MediaTabOpen;

    string IconFor(string mime) => mime switch
    {
        "application/pdf" => "bi-file-earmark-pdf",
        var m when m.StartsWith("audio/") => "bi-music-note-beamed",
        var m when m.StartsWith("image/") => "bi-file-earmark-image",
        _ => "bi-file-earmark",
    };
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="page-title mb-0">Lưu trữ &amp; Media Browser <span class="text-muted fs-6 fw-normal">Local Disk · S3 / MinIO</span></h1>
    <span class="text-muted small">Secret Access Key luôn được che; chỉ nhập lại khi muốn thay.</span>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" role="alert" id="flash-message">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert" id="flash-error">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning" role="alert" id="load-error"><i class="bi bi-exclamation-triangle me-1"></i>@Model.LoadError</div>
}

<form method="get" class="row g-2 align-items-end mb-3" id="project-form">
    <input type="hidden" name="tab" value="@(mediaOpen ? "media" : "config")" id="tab-field" />
    <div class="col-12 col-md-4 col-lg-3">
        <label class="form-label small mb-1" for="project">Dự án</label>
        <select class="form-select" id="project" name="project" onchange="this.form.submit()">
            @foreach (var project in Model.Projects)
            {
                <option value="@project" selected="@(project == Model.Project)">@project</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat me-1"></i>Tải</button>
    </div>
    <div class="col text-muted small" id="current-version">
        @if (Model.Current is { } current)
        {
            <span>Đang hiển thị <strong>@current.Name</strong> phiên bản <strong>v@(current.Version)</strong>
                <span class="badge @UiHelpers.StatusBadge(current.Status)">@current.Status</span></span>
            @if (Model.LiveVersion is { } live)
            {
                <span id="live-version" class="ms-2">· Đang hoạt động: <strong>v@(live.Version)</strong> (bản này chưa được dùng)</span>
            }
        }
        else
        {
            <span>Dự án này chưa có cấu hình lưu trữ; dùng cấu hình của dự án <code>default</code> khi tải lên.</span>
        }
    </div>
</form>

<ul class="nav nav-tabs mb-3" id="storage-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link @(mediaOpen ? string.Empty : "active")" id="tab-config" data-bs-toggle="tab" data-bs-target="#pane-config" data-tab="config" type="button" role="tab"><i class="bi bi-gear me-1"></i>Cấu Hình Lưu Trữ</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link @(mediaOpen ? "active" : string.Empty)" id="tab-media" data-bs-toggle="tab" data-bs-target="#pane-media" data-tab="media" type="button" role="tab"><i class="bi bi-images me-1"></i>Media Browser <span class="badge text-bg-secondary" id="file-count">@Model.Files.Count</span></button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade @(mediaOpen ? string.Empty : "show active")" id="pane-config" role="tabpanel">
        <form method="post" id="storage-form" class="card shadow-sm mb-4">
            <div class="card-body">
                <input type="hidden" asp-for="Form.ProjectCode" value="@Model.Project" />

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Form.Name">Tên cấu hình</label>
                        <input class="form-control" asp-for="Form.Name" maxlength="100" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Form.ProviderType">Nhà cung cấp</label>
                        <select class="form-select" asp-for="Form.ProviderType">
                            @foreach (var option in StorageModel.Providers)
                            {
                                <option value="@option" selected="@(option == provider)">@option</option>
                            }
                        </select>
                    </div>
                </div>
                <hr />

                <div class="provider-section row g-3 @Hidden("LocalDisk")" data-provider="LocalDisk">
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Form.RootPath">Thư mục gốc (RootPath)</label>
                        <input class="form-control" asp-for="Form.RootPath" id="Form_RootPath" placeholder="uploads" autocomplete="off" />
                        <div class="form-text">Đường dẫn tương đối, nằm trong thư mục lưu trữ của máy chủ; không dùng <code>..</code>.</div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label" asp-for="Form.MaxFileSizeMb">Dung lượng tối đa (MB)</label>
                        <input class="form-control" type="number" min="1" max="50" asp-for="Form.MaxFileSizeMb" id="Form_MaxFileSizeMb" placeholder="15" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Form.PublicUrlBase">Public URL Base <span class="text-muted small">(không bắt buộc)</span></label>
                        <input class="form-control" type="url" asp-for="Form.PublicUrlBase" id="Form_PublicUrlBase" placeholder="https://cdn.example.com/files" autocomplete="off" />
                    </div>
                </div>

                <div class="provider-section row g-3 @Hidden("S3")" data-provider="S3">
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Form.Bucket">Bucket</label>
                        <input class="form-control" asp-for="Form.Bucket" autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Form.Region">Region <span class="text-muted small">(AWS)</span></label>
                        <input class="form-control" asp-for="Form.Region" placeholder="ap-southeast-1" autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Form.ServiceUrl">Service URL <span class="text-muted small">(MinIO / R2)</span></label>
                        <input class="form-control" type="url" asp-for="Form.ServiceUrl" placeholder="http://minio.local:9000" autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-6 d-flex align-items-end">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" asp-for="Form.ForcePathStyle" />
                            <label class="form-check-label" asp-for="Form.ForcePathStyle">Force Path Style</label>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label" asp-for="Form.AccessKeyId">Access Key ID</label>
                        <input class="form-control" asp-for="Form.AccessKeyId" autocomplete="off" />
                    </div>
                    <div class="col-12 col-md-6" id="secret-group">
                        <label class="form-label" for="Form_Secret">Secret Access Key</label>
                        <input class="form-control secret-mask" type="password" id="Form_Secret" name="Form.Secret" value="@Model.Form.Secret" autocomplete="new-password" />
                        <div class="form-text">Đã lưu thì hiển thị <span class="secret-mask">••••••••</span>; để nguyên nếu không đổi, gõ giá trị mới để thay.</div>
                    </div>
                </div>

                <div class="provider-section row g-3 @Hidden("Mock")" data-provider="Mock">
                    <div class="col-12">
                        <div class="alert alert-info mb-0" id="mock-note">
                            <i class="bi bi-info-circle me-1"></i>Mock: tệp chỉ được giữ trong <strong>bộ nhớ</strong> của máy chủ và mất khi khởi động lại; <strong>không cần secret</strong>.
                            Dùng cho môi trường phát triển và kiểm thử.
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-footer bg-transparent">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <button type="button" class="btn btn-outline-primary" id="send-test-button" data-url="@Url.Page("/Storage", "SendTest")">
                        <span class="spinner-border spinner-border-sm d-none me-1" id="send-test-spinner" role="status" aria-hidden="true"></span>
                        <i class="bi bi-plug me-1" id="send-test-icon"></i>Kiểm Tra Kết Nối
                    </button>
                    <div id="send-test-result" class="small flex-grow-1" aria-live="polite"></div>
                </div>
                <hr />
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-secondary" id="save-draft" asp-page-handler="SaveDraft"><i class="bi bi-save me-1"></i>Lưu Bản Nháp</button>
                    <button type="submit" class="btn btn-success" id="save-activate" asp-page-handler="SaveActivate"><i class="bi bi-play-fill me-1"></i>Lưu &amp; Kích Hoạt</button>
                </div>
                <p class="text-muted small mt-2 mb-0">Kiểm tra kết nối dùng đúng các giá trị đang nhập (ghi, đọc, xóa một tệp 1 byte), <strong>không lưu</strong> và <strong>không kích hoạt</strong> cấu hình.</p>
            </div>
        </form>
    </div>

    <div class="tab-pane fade @(mediaOpen ? "show active" : string.Empty)" id="pane-media" role="tabpanel">
        <form method="post" asp-page-handler="Upload" enctype="multipart/form-data" class="card shadow-sm mb-3" id="upload-form">
            <div class="card-body">
                <input type="hidden" name="project" value="@Model.Project" />
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-6">
                        <label class="form-label small mb-1" for="upload">Tải lên nhanh <span class="text-muted">(ảnh PNG/JPEG/WebP/GIF, PDF, âm thanh MP3/OGG/WAV)</span></label>
                        <input class="form-control" type="file" id="upload" name="upload" />
                    </div>
                    <div class="col-auto">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="isPublic" name="isPublic" value="true" />
                            <label class="form-check-label" for="isPublic">Công khai</label>
                        </div>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary" id="upload-button"><i class="bi bi-cloud-arrow-up me-1"></i>Tải lên</button>
                    </div>
                </div>
                <div class="form-text">Loại tệp được xác định từ nội dung thật, không theo đuôi tên hay Content-Type: tệp đổi đuôi sẽ bị từ chối.</div>
            </div>
        </form>

        @if (Model.Files.Count == 0)
        {
            <div class="text-center text-muted py-5 card shadow-sm mb-4" id="no-files">Chưa có tệp nào trong dự án này.</div>
        }
        else
        {
            <div class="row row-cols-2 row-cols-md-3 row-cols-xl-4 g-3 mb-4" id="file-grid">
                @foreach (var file in Model.Files)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm file-card" data-file-id="@file.Id" data-mime="@file.MimeType">
                            <div class="file-preview d-flex align-items-center justify-content-center bg-light" style="height:150px;overflow:hidden">
                                @if (file.HasThumbnail)
                                {
                                    <img src="@Url.Page("/Storage", "Thumb", new { id = file.Id })" alt="@file.OriginalFileName" loading="lazy" class="thumb" style="max-width:100%;max-height:150px;object-fit:cover"
                                         onerror="this.replaceWith(Object.assign(document.createElement('i'), { className: 'bi bi-file-earmark-image fs-1 text-muted' }))" />
                                }
                                else
                                {
                                    <i class="bi @IconFor(file.MimeType) fs-1 text-muted"></i>
                                }
                            </div>
                            <div class="card-body py-2">
                                <div class="fw-semibold text-truncate" title="@file.OriginalFileName">@file.OriginalFileName</div>
                                <div class="small text-muted">@StorageModel.FormatSize(file.FileSizeBytes) · @file.MimeType</div>
                                <div class="small text-muted">@file.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm") UTC
                                    @if (file.IsPublic)
                                    {
                                        <span class="badge text-bg-info ms-1">Công khai</span>
                                    }
                                </div>
                            </div>
                            <div class="card-footer bg-transparent d-flex gap-1">
                                <a class="btn btn-sm btn-outline-secondary view-link" target="_blank" rel="noopener" href="@Url.Page("/Storage", "File", new { id = file.Id })"><i class="bi bi-eye"></i> Xem</a>
                                <a class="btn btn-sm btn-outline-secondary download-link" href="@Url.Page("/Storage", "File", new { id = file.Id, download = true })"><i class="bi bi-download"></i> Tải</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@file.Id" asp-route-project="@Model.Project" class="ms-auto" onsubmit="return confirm('Xóa tệp này?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger delete-button"><i class="bi bi-trash"></i> Xóa</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <div class="card shadow-sm">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <strong>Nhật ký Media gần đây</strong>
                <span class="text-muted small">Dự án: @Model.Project</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="media-logs">
                    <thead class="table-light">
                        <tr><th>Thời gian (UTC)</th><th>Hành động</th><th>Trạng thái</th><th>Ghi chú</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs)
                        {
                            <tr data-action="@log.Action" data-status="@log.Status">
                                <td>@log.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@log.Action</td>
                                <td>
                                    @if (log.Status == "Success")
                                    {
                                        <span class="badge text-bg-success">Thành công</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-danger">Thất bại</span>
                                    }
                                </td>
                                <td class="text-muted small">@log.ErrorMessage</td>
                            </tr>
                        }
                        @if (Model.Logs.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4" id="no-logs">Chưa có hoạt động nào cho dự án này.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('storage-form');
            var provider = document.getElementById('Form_ProviderType');
            var secret = document.getElementById('Form_Secret');
            var mask = '••••••••';

            function showProvider() {
                var chosen = provider.value;
                document.querySelectorAll('.provider-section').forEach(function (section) {
                    section.classList.toggle('d-none', section.dataset.provider !== chosen);
                });
            }

            provider.addEventListener('change', function () {
                // A stored secret belongs to the previous provider: do not carry the mask over.
                if (secret.value === mask) secret.value = '';
                showProvider();
            });
            showProvider();

            // The project selector reloads the page on the tab that is open.
            var tabField = document.getElementById('tab-field');
            document.querySelectorAll('#storage-tabs [data-tab]').forEach(function (button) {
                button.addEventListener('shown.bs.tab', function () { tabField.value = button.dataset.tab; });
            });

            var button = document.getElementById('send-test-button');
            var spinner = document.getElementById('send-test-spinner');
            var icon = document.getElementById('send-test-icon');
            var result = document.getElementById('send-test-result');

            function show(success, text) {
                result.innerHTML = '';
                var alert = document.createElement('div');
                alert.className = 'alert py-2 mb-0 ' + (success ? 'alert-success' : 'alert-danger');
                alert.id = success ? 'send-test-ok' : 'send-test-fail';
                alert.setAttribute('role', 'alert');
                var mark = document.createElement('i');
                mark.className = 'bi me-1 ' + (success ? 'bi-check-circle-fill' : 'bi-x-circle-fill');
                alert.appendChild(mark);
                alert.appendChild(document.createTextNode(text));   // text, never HTML
                result.appendChild(alert);
            }

            button.addEventListener('click', function () {
                var token = form.querySelector('input[name="__RequestVerificationToken"]');
                button.disabled = true;
                spinner.classList.remove('d-none');
                icon.classList.add('d-none');
                result.textContent = '';

                fetch(button.dataset.url, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token ? token.value : '' },
                    body: new FormData(form),
                    credentials: 'same-origin'
                }).then(function (response) {
                    if (!response.ok) throw new Error('HTTP ' + response.status);
                    return response.json();
                }).then(function (data) {
                    show(data.success, data.message + (data.latencyMs ? ' (' + data.latencyMs + ' ms)' : ''));
                }).catch(function () {
                    show(false, 'Không gửi được yêu cầu kiểm tra. Hãy tải lại trang và thử lại.');
                }).finally(function () {
                    button.disabled = false;
                    spinner.classList.add('d-none');
                    icon.classList.remove('d-none');
                });
            });
        })();
    </script>
}
