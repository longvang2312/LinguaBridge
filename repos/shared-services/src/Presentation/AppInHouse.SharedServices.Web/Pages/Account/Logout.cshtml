@page
@model AppInHouse.SharedServices.Web.Pages.Account.LogoutModel
@{
    ViewData["Title"] = "Đăng xuất";
    ViewData["Bare"] = true;
}

<div class="mx-auto" style="max-width: 32rem;">
    @if (Model.SignedOut)
    {
        <h1 class="page-title mb-3"><i class="bi bi-check-circle text-success me-2"></i>Bạn đã đăng xuất</h1>
        <p id="signed-out">Phiên làm việc đã kết thúc, cả ở trang quản trị này lẫn ở AppInHouse Identity.</p>
        <a class="btn btn-primary" id="sign-in-again" asp-page="/Account/Login">Đăng nhập lại</a>
    }
    else
    {
        <h1 class="page-title mb-3">Đăng xuất?</h1>
        <p>Phiên làm việc sẽ kết thúc ở trang quản trị này và ở AppInHouse Identity.</p>
        <form method="post">
            <button type="submit" class="btn btn-danger" id="confirm-logout"><i class="bi bi-box-arrow-right me-1"></i>Đăng xuất</button>
            <a class="btn btn-link" href="/">Hủy</a>
        </form>
    }
</div>
