@page
@model AppInHouse.SharedServices.Web.Pages.EmailModel
@{
    ViewData["Title"] = "Cấu hình Email";
    var provider = Model.Form.ProviderType;
    string Hidden(string name) => provider == name ? string.Empty : "d-none";
    var secretLabel = provider == "SendGrid" ? "API Key" : "Mật khẩu SMTP";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="page-title mb-0">Cấu hình Email</h1>
    <span class="text-muted small">Secret luôn được che; chỉ nhập lại khi muốn thay.</span>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" role="alert" id="flash-message">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert" id="flash-error">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning" role="alert" id="load-error"><i class="bi bi-exclamation-triangle me-1"></i>@Model.LoadError</div>
}

<form method="get" class="row g-2 align-items-end mb-3" id="project-form">
    <div class="col-12 col-md-4 col-lg-3">
        <label class="form-label small mb-1" for="project">Dự án</label>
        <select class="form-select" id="project" name="project" onchange="this.form.submit()">
            @foreach (var project in Model.Projects)
            {
                <option value="@project" selected="@(project == Model.Project)">@project</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat me-1"></i>Tải</button>
    </div>
    <div class="col text-muted small" id="current-version">
        @if (Model.Current is { } current)
        {
            <span>Đang hiển thị <strong>@current.Name</strong> phiên bản <strong>v@(current.Version)</strong>
                <span class="badge @UiHelpers.StatusBadge(current.Status)">@current.Status</span></span>
            @if (Model.LiveVersion is { } live)
            {
                <span id="live-version" class="ms-2">· Đang hoạt động: <strong>v@(live.Version)</strong> (bản này chưa được dùng)</span>
            }
        }
        else
        {
            <span>Dự án này chưa có cấu hình email; dùng cấu hình của dự án <code>default</code> khi gửi.</span>
        }
    </div>
</form>

<form method="post" id="email-form" class="card shadow-sm mb-4">
    <div class="card-body">
        <input type="hidden" asp-for="Form.ProjectCode" value="@Model.Project" />

        <div class="row g-3">
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Form.Name">Tên cấu hình</label>
                <input class="form-control" asp-for="Form.Name" maxlength="100" />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Form.ProviderType">Nhà cung cấp</label>
                <select class="form-select" asp-for="Form.ProviderType">
                    @foreach (var option in AppInHouse.SharedServices.Web.Pages.EmailModel.Providers)
                    {
                        <option value="@option" selected="@(option == provider)">@(option == "Smtp" ? "SMTP" : option)</option>
                    }
                </select>
            </div>
        </div>

        <hr />

        <div class="provider-section row g-3 @Hidden("Smtp")" data-provider="Smtp">
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Form.SmtpHost">Host</label>
                <input class="form-control" asp-for="Form.SmtpHost" placeholder="smtp.example.com" autocomplete="off" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label" asp-for="Form.SmtpPort">Port</label>
                <input class="form-control" asp-for="Form.SmtpPort" inputmode="numeric" />
            </div>
            <div class="col-6 col-md-4">
                <label class="form-label" asp-for="Form.SmtpSecurity">SSL</label>
                <select class="form-select" asp-for="Form.SmtpSecurity">
                    @foreach (var option in AppInHouse.SharedServices.Web.Pages.EmailModel.SmtpSecurityOptions)
                    {
                        <option value="@option" selected="@(option == Model.Form.SmtpSecurity)">@option</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Form.SmtpUsername">Tên đăng nhập SMTP <span class="text-muted small">(không bắt buộc)</span></label>
                <input class="form-control" asp-for="Form.SmtpUsername" autocomplete="off" />
            </div>
        </div>

        <div class="provider-section row g-3 @Hidden("SendGrid")" data-provider="SendGrid">
            <div class="col-12">
                <p class="text-muted small mb-0">Gửi qua SendGrid REST API v3. Nhập API Key ở ô bên dưới; địa chỉ người gửi phải là địa chỉ đã xác minh trên SendGrid.</p>
            </div>
        </div>

        <div class="provider-section row g-3 @Hidden("Mock")" data-provider="Mock">
            <div class="col-12">
                <div class="alert alert-info mb-0" id="mock-note">
                    <i class="bi bi-info-circle me-1"></i>Mock: giả lập việc gửi, không có kết nối mạng và <strong>không cần secret</strong>.
                    Email chỉ được ghi vào bộ nhớ và nhật ký, dùng cho môi trường phát triển và kiểm thử.
                </div>
            </div>
        </div>

        <div class="row g-3 mt-0">
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Form.SenderEmail">Email người gửi</label>
                <input class="form-control" type="email" asp-for="Form.SenderEmail" placeholder="noreply@example.com" autocomplete="off" />
            </div>
            <div class="col-12 col-md-6">
                <label class="form-label" asp-for="Form.SenderName">Tên người gửi</label>
                <input class="form-control" asp-for="Form.SenderName" maxlength="100" autocomplete="off" />
            </div>
            <div class="col-12 col-md-6 @Hidden(provider == "Mock" ? "none" : provider)" id="secret-group">
                <label class="form-label" for="Form_Secret" id="secret-label">@secretLabel</label>
                <input class="form-control secret-mask" type="password" id="Form_Secret" name="Form.Secret" value="@Model.Form.Secret" autocomplete="new-password" />
                <div class="form-text">Đã lưu thì hiển thị <span class="secret-mask">••••••••</span>; để nguyên nếu không đổi, gõ giá trị mới để thay.</div>
            </div>
        </div>
    </div>

    <div class="card-footer bg-transparent">
        <div class="row g-2 align-items-end">
            <div class="col-12 col-md-5 col-lg-4">
                <label class="form-label small mb-1" asp-for="Form.TestRecipient">Email người nhận thử nghiệm</label>
                <input class="form-control" type="email" asp-for="Form.TestRecipient" placeholder="you@example.com" autocomplete="off" />
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-outline-primary" id="send-test-button" data-url="@Url.Page("/Email", "SendTest")">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="send-test-spinner" role="status" aria-hidden="true"></span>
                    <i class="bi bi-send me-1" id="send-test-icon"></i>Gửi Thử Nghiệm
                </button>
            </div>
            <div class="col-12 col-lg" aria-live="polite">
                <div id="send-test-result" class="small"></div>
            </div>
        </div>
        <hr />
        <div class="d-flex flex-wrap gap-2">
            <button type="submit" class="btn btn-secondary" id="save-draft" asp-page-handler="SaveDraft"><i class="bi bi-save me-1"></i>Lưu Bản Nháp</button>
            <button type="submit" class="btn btn-success" id="save-activate" asp-page-handler="SaveActivate"><i class="bi bi-play-fill me-1"></i>Lưu &amp; Kích Hoạt</button>
        </div>
        <p class="text-muted small mt-2 mb-0">Gửi thử dùng đúng các giá trị đang nhập, <strong>không lưu</strong> và <strong>không kích hoạt</strong> cấu hình.</p>
    </div>
</form>

<div class="card shadow-sm">
    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
        <strong>Lịch sử gửi email gần đây</strong>
        <span class="text-muted small">Dự án: @Model.Project</span>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="delivery-logs">
            <thead class="table-light">
                <tr><th>Thời gian (UTC)</th><th>Người nhận</th><th>Trạng thái</th><th class="text-end">Độ trễ</th><th>Phản hồi</th></tr>
            </thead>
            <tbody>
                @foreach (var log in Model.Logs)
                {
                    <tr data-status="@log.Status">
                        <td>@log.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@log.Recipient</td>
                        <td>
                            @if (log.Status == "Sent")
                            {
                                <span class="badge text-bg-success">Thành công</span>
                            }
                            else
                            {
                                <span class="badge text-bg-danger">Thất bại</span>
                            }
                        </td>
                        <td class="text-end">@(log.LatencyMs is { } ms ? $"{ms} ms" : "—")</td>
                        <td class="text-muted small">@log.ProviderResponse</td>
                    </tr>
                }
                @if (Model.Logs.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-4" id="no-logs">Chưa có email nào được gửi cho dự án này.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('email-form');
            var provider = document.getElementById('Form_ProviderType');
            var secret = document.getElementById('Form_Secret');
            var mask = '••••••••';
            var labels = { Smtp: 'Mật khẩu SMTP', SendGrid: 'API Key' };

            function showProvider() {
                var chosen = provider.value;
                document.querySelectorAll('.provider-section').forEach(function (section) {
                    section.classList.toggle('d-none', section.dataset.provider !== chosen);
                });
                document.getElementById('secret-group').classList.toggle('d-none', chosen === 'Mock');
                document.getElementById('secret-label').textContent = labels[chosen] || 'Secret';
            }

            var lastProvider = provider.value;
            provider.addEventListener('change', function () {
                // A stored secret belongs to the previous provider: do not carry the mask over, the new one has to be typed.
                if (secret.value === mask) secret.value = '';
                lastProvider = provider.value;
                showProvider();
            });
            showProvider();

            var button = document.getElementById('send-test-button');
            var spinner = document.getElementById('send-test-spinner');
            var icon = document.getElementById('send-test-icon');
            var result = document.getElementById('send-test-result');

            function show(success, text) {
                result.innerHTML = '';
                var alert = document.createElement('div');
                alert.className = 'alert py-2 mb-0 ' + (success ? 'alert-success' : 'alert-danger');
                alert.id = success ? 'send-test-ok' : 'send-test-fail';
                alert.setAttribute('role', 'alert');
                var mark = document.createElement('i');
                mark.className = 'bi me-1 ' + (success ? 'bi-check-circle-fill' : 'bi-x-circle-fill');
                alert.appendChild(mark);
                alert.appendChild(document.createTextNode(text));   // text, never HTML
                result.appendChild(alert);
            }

            button.addEventListener('click', function () {
                var token = form.querySelector('input[name="__RequestVerificationToken"]');
                button.disabled = true;
                spinner.classList.remove('d-none');
                icon.classList.add('d-none');
                result.textContent = '';

                fetch(button.dataset.url, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token ? token.value : '' },
                    body: new FormData(form),
                    credentials: 'same-origin'
                }).then(function (response) {
                    if (!response.ok) throw new Error('HTTP ' + response.status);
                    return response.json();
                }).then(function (data) {
                    show(data.success, data.message + (data.latencyMs ? ' (' + data.latencyMs + ' ms)' : ''));
                }).catch(function () {
                    show(false, 'Không gửi được yêu cầu thử nghiệm. Hãy tải lại trang và thử lại.');
                }).finally(function () {
                    button.disabled = false;
                    spinner.classList.add('d-none');
                    icon.classList.remove('d-none');
                });
            });
        })();
    </script>
}
