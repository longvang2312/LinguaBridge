@page
@model AppInHouse.SharedServices.Web.Pages.ApiKeysModel
@{
    ViewData["Title"] = "Ứng dụng & API Keys";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="page-title mb-0">Ứng dụng &amp; API Keys</h1>
    <span class="text-muted small">Key chỉ hiển thị đầy đủ một lần khi tạo; hệ thống chỉ lưu mã băm SHA-256 và tiền tố.</span>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" role="alert" id="flash-message">@Model.Message</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert" id="flash-error">@Model.ErrorMessage</div>
}
@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning" role="alert" id="load-error"><i class="bi bi-exclamation-triangle me-1"></i>@Model.LoadError</div>
}

<form method="post" asp-page-handler="Create" class="card shadow-sm mb-4" id="new-key-form">
    <div class="card-header bg-transparent"><strong><i class="bi bi-plus-circle me-1"></i>Tạo API Key</strong></div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.FormError))
        {
            <div class="alert alert-danger" role="alert" id="form-error">@Model.FormError</div>
        }
        <div class="row g-3">
            <div class="col-12 col-md-4">
                <label class="form-label" for="Form_ProjectCode">Dự án</label>
                <input class="form-control" id="Form_ProjectCode" name="Form.ProjectCode" value="@Model.Form.ProjectCode" list="project-list" maxlength="50" required autocomplete="off" />
                <datalist id="project-list">
                    @foreach (var project in Model.Projects)
                    {
                        <option value="@project"></option>
                    }
                </datalist>
            </div>
            <div class="col-12 col-md-5">
                <label class="form-label" for="Form_Name">Tên key</label>
                <input class="form-control" id="Form_Name" name="Form.Name" value="@Model.Form.Name" maxlength="100" required placeholder="Ví dụ: LinguaBridge API (production)" autocomplete="off" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="Form_ExpiresInDays">Hạn dùng</label>
                <select class="form-select" id="Form_ExpiresInDays" name="Form.ExpiresInDays">
                    @foreach (var (label, days) in ApiKeysModel.Lifetimes)
                    {
                        <option value="@days" selected="@(days == Model.Form.ExpiresInDays)">@label</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label d-block">Quyền (scopes)</label>
                @foreach (var scope in ApiKeysModel.Scopes)
                {
                    var id = "scope_" + scope.Replace(':', '_');
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="checkbox" id="@id" name="Form.Scopes" value="@scope" checked="@Model.Form.Scopes.Contains(scope)" />
                        <label class="form-check-label" for="@id"><code>@scope</code></label>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="card-footer bg-transparent">
        <button type="submit" class="btn btn-primary" id="create-key-button"><i class="bi bi-key me-1"></i>Tạo key</button>
    </div>
</form>

<form method="get" class="row g-2 align-items-end mb-3" id="project-filter">
    <div class="col-12 col-md-4 col-lg-3">
        <label class="form-label small mb-1" for="project">Lọc theo dự án</label>
        <select class="form-select" id="project" name="project" onchange="this.form.submit()">
            <option value="" selected="@string.IsNullOrEmpty(Model.Project)">Tất cả dự án</option>
            @foreach (var project in Model.Projects)
            {
                <option value="@project" selected="@(project == Model.Project)">@project</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat me-1"></i>Tải</button>
    </div>
</form>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="keys-table">
            <thead class="table-light">
                <tr><th>Tên key</th><th>Dự án</th><th>Tiền tố</th><th>Scopes</th><th>Trạng thái</th><th>Tạo lúc (UTC)</th><th>Hết hạn</th><th>Dùng gần nhất</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var key in Model.Keys)
                {
                    <tr data-key-id="@key.Id" data-status="@key.Status">
                        <td class="fw-semibold">@key.Name</td>
                        <td>@key.ProjectCode</td>
                        <td><code>@(key.KeyPrefix)…</code></td>
                        <td>
                            @foreach (var scope in key.Scopes)
                            {
                                <span class="badge text-bg-light border me-1">@scope</span>
                            }
                        </td>
                        <td><span class="badge @ApiKeysModel.StatusBadge(key.Status)">@ApiKeysModel.StatusLabel(key.Status)</span></td>
                        <td class="text-nowrap">@key.CreatedAt.UtcDateTime.ToString("yyyy-MM-dd HH:mm")</td>
                        <td class="text-nowrap">@(key.ExpiresAt is { } expires ? expires.UtcDateTime.ToString("yyyy-MM-dd HH:mm") : "Không hết hạn")</td>
                        <td class="text-nowrap">@(key.LastUsedAt is { } used ? used.UtcDateTime.ToString("yyyy-MM-dd HH:mm") : "Chưa dùng")</td>
                        <td class="text-nowrap text-end">
                            @if (key.Status == "Active")
                            {
                                <form method="post" asp-page-handler="Rotate" asp-route-id="@key.Id" asp-route-graceDays="7" class="d-inline" onsubmit="return confirm('Tạo key mới thay thế? Key cũ vẫn dùng được thêm 7 ngày rồi ngừng.');">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary rotate-button"><i class="bi bi-arrow-repeat"></i> Luân chuyển</button>
                                </form>
                                <form method="post" asp-page-handler="Revoke" asp-route-id="@key.Id" asp-route-project="@Model.Project" class="d-inline" onsubmit="return confirm('Thu hồi key này? Mọi ứng dụng đang dùng nó sẽ bị từ chối ngay lập tức.');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger revoke-button"><i class="bi bi-slash-circle"></i> Thu hồi</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Keys.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4" id="no-keys">Chưa có API key nào@(string.IsNullOrEmpty(Model.Project) ? string.Empty : " cho dự án " + Model.Project).</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.PlainTextKey is { } plain && Model.CreatedKey is { } created)
{
    <div class="modal fade" id="new-key-modal" tabindex="-1" aria-labelledby="new-key-title" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="new-key-title"><i class="bi bi-key-fill me-1"></i>@(Model.CreatedHow == "rotated" ? "Key mới đã được tạo" : "API Key đã được tạo")</h2>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning" role="alert" id="one-time-warning">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i><strong>Chỉ hiển thị một lần.</strong>
                        Hãy sao chép và cất vào nơi an toàn (secret store) ngay bây giờ. Sau khi đóng hộp thoại này không thể xem lại key; nếu mất, phải tạo key mới.
                    </div>
                    <dl class="row mb-2">
                        <dt class="col-sm-3">Tên</dt><dd class="col-sm-9">@created.Name</dd>
                        <dt class="col-sm-3">Dự án</dt><dd class="col-sm-9">@created.ProjectCode</dd>
                        <dt class="col-sm-3">Hết hạn</dt><dd class="col-sm-9">@(created.ExpiresAt is { } e ? e.UtcDateTime.ToString("yyyy-MM-dd HH:mm") + " UTC" : "Không hết hạn")</dd>
                        @if (Model.RetiredKey is { } retired)
                        {
                            <dt class="col-sm-3">Key cũ</dt>
                            <dd class="col-sm-9" id="retired-note"><code>@(retired.KeyPrefix)…</code> vẫn dùng được đến @(retired.ExpiresAt is { } until ? until.UtcDateTime.ToString("yyyy-MM-dd HH:mm") + " UTC" : "khi bị thu hồi"), rồi ngừng.</dd>
                        }
                    </dl>
                    <label class="form-label" for="plain-key">API Key</label>
                    <div class="input-group">
                        <input type="text" class="form-control font-monospace" id="plain-key" value="@plain" readonly />
                        <button type="button" class="btn btn-outline-primary" id="copy-key-button"><i class="bi bi-clipboard me-1"></i><span id="copy-key-label">Sao chép</span></button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" id="close-key-modal">Đã lưu key, đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (Model.PlainTextKey is not null)
    {
    <script>
        (function () {
            var modalElement = document.getElementById('new-key-modal');
            if (!modalElement) return;

            var modal = new bootstrap.Modal(modalElement);
            modal.show();

            var field = document.getElementById('plain-key');
            var label = document.getElementById('copy-key-label');
            document.getElementById('copy-key-button').addEventListener('click', function () {
                function done() { label.textContent = 'Đã sao chép'; }
                function legacyCopy() {
                    // The clipboard API needs a secure page and a permission; selecting the text and copying works without either.
                    field.focus();
                    field.select();
                    var copied = false;
                    try { copied = document.execCommand('copy'); } catch (e) { copied = false; }
                    label.textContent = copied ? 'Đã sao chép' : 'Chọn và nhấn Ctrl+C';
                }
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(field.value).then(done, legacyCopy);
                } else {
                    legacyCopy();
                }
            });

            // Once the box is closed the key is removed from the page, so it cannot be read from the DOM afterwards.
            modalElement.addEventListener('hidden.bs.modal', function () { field.value = ''; modalElement.remove(); });
        })();
    </script>
    }
}
