@page
@model AppInHouse.SharedServices.Web.Pages.ChatModel
@{
    ViewData["Title"] = "Trò chuyện trực tuyến";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="page-title mb-0">Trò Chuyện Trực Tuyến <span class="text-muted fs-6 fw-normal">1-1 · Nhóm · SignalR</span></h1>
    <span class="text-muted small" id="bots-moved">
        Telegram, Discord, Slack đã chuyển sang <a asp-page="/Notifications/Channels" id="bots-link">Thông Báo Đa Kênh</a>.
    </span>
</div>

<form method="get" class="row g-2 align-items-end mb-3" id="project-form">
    <div class="col-12 col-md-4 col-lg-3">
        <label class="form-label small mb-1" for="project">Dự án</label>
        <select class="form-select" id="project" name="project" onchange="this.form.submit()">
            @foreach (var project in Model.Projects)
            {
                <option value="@project" selected="@(project == Model.Project)">@project</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary"><i class="bi bi-arrow-repeat me-1"></i>Tải</button>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.MonitorError))
{
    <div class="alert alert-warning" role="alert" id="monitor-error"><i class="bi bi-exclamation-triangle me-1"></i>@Model.MonitorError</div>
}

@if (Model.Monitor is { } monitor)
{
    <div class="row g-3 mb-4" id="monitor-metrics">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="quick-metric-card">
                <div class="quick-metric-icon bg-primary-subtle text-primary"><i class="bi bi-chat-square-text"></i></div>
                <div>
                    <div class="quick-metric-val" id="metric-conversations">@monitor.Conversations</div>
                    <div class="quick-metric-lbl">Hội thoại (@monitor.DirectConversations 1-1 · @monitor.GroupConversations nhóm)</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="quick-metric-card">
                <div class="quick-metric-icon bg-success-subtle text-success"><i class="bi bi-chat-dots"></i></div>
                <div>
                    <div class="quick-metric-val" id="metric-messages-today">@monitor.MessagesToday</div>
                    <div class="quick-metric-lbl">Tin nhắn hôm nay (UTC)</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="quick-metric-card">
                <div class="quick-metric-icon bg-info-subtle text-info"><i class="bi bi-person-check"></i></div>
                <div>
                    <div class="quick-metric-val" id="metric-online">@monitor.OnlineUsers</div>
                    <div class="quick-metric-lbl">Người dùng đang online</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="quick-metric-card">
                <div class="quick-metric-icon bg-warning-subtle text-warning"><i class="bi bi-ethernet"></i></div>
                <div>
                    <div class="quick-metric-val" id="metric-connections">@monitor.Connections</div>
                    <div class="quick-metric-lbl">Kết nối WebSocket đang mở</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">Đang online</div>
        <div class="card-body" id="online-users">
            @if (monitor.OnlineUserIds.Count == 0)
            {
                <span class="text-muted" id="no-online">Chưa có ai đang kết nối.</span>
            }
            else
            {
                @foreach (var id in monitor.OnlineUserIds)
                {
                    <span class="badge text-bg-success me-1 mb-1" data-user="@id"><i class="bi bi-circle-fill me-1 small"></i>@id</span>
                }
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">Hội thoại gần đây <span class="text-muted fw-normal small">· chỉ hiện tiêu đề và số lượng, không hiện nội dung tin nhắn</span></div>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0" id="conversations-table">
                <thead class="table-light"><tr><th>Hội thoại</th><th>Loại</th><th class="text-end">Thành viên</th><th class="text-end">Tin nhắn</th><th>Hoạt động cuối</th></tr></thead>
                <tbody>
                    @foreach (var c in monitor.Recent)
                    {
                        <tr data-conversation="@c.Id">
                            <td>@(c.Title ?? "Chat 1-1")</td>
                            <td><span class="badge @(c.Type == "Group" ? "text-bg-primary" : "text-bg-secondary")">@c.Type</span></td>
                            <td class="text-end">@c.MemberCount</td>
                            <td class="text-end">@c.MessageCount</td>
                            <td>@c.LastMessageAt.ToString("dd/MM/yyyy HH:mm:ss") UTC</td>
                        </tr>
                    }
                    @if (monitor.Recent.Count == 0)
                    {
                        <tr id="no-conversations"><td colspan="5" class="text-center text-muted py-3">Dự án này chưa có hội thoại nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="card shadow-sm mb-4" id="realtime-card">
    <div class="card-header bg-white fw-semibold">Kiểm tra luồng SignalR / WebSocket</div>
    <div class="card-body">
        <p class="text-muted small mb-2">Hub: <code>/hubs/chat</code>. Nút dưới đây yêu cầu hub thương lượng một kết nối bằng khóa API của cổng này (không mở kết nối thật, nên không ai bị tính là online).</p>
        <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
            <input type="hidden" name="project" value="@Model.Project" />
            <input type="hidden" name="check" value="true" />
            <button type="submit" class="btn btn-outline-primary" id="check-realtime-button"><i class="bi bi-activity me-1"></i>Kiểm tra kết nối</button>
            @if (Model.Realtime is { } realtime)
            {
                <span class="alert py-2 px-3 mb-0 @(realtime.Reachable ? "alert-success" : "alert-danger")" role="alert" id="realtime-result" data-reachable="@realtime.Reachable.ToString().ToLowerInvariant()">
                    <i class="bi me-1 @(realtime.Reachable ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>@realtime.Message
                    @if (realtime.Transports.Count > 0) { <span class="ms-1">(@string.Join(", ", realtime.Transports) · @realtime.LatencyMs ms)</span> }
                </span>
            }
        </form>
    </div>
</div>
