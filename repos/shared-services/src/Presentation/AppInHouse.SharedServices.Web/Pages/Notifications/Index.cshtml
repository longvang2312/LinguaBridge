@page
@model AppInHouse.SharedServices.Web.Pages.Notifications.IndexModel
@{
    ViewData["Title"] = "Notification Hub";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Shared Services</a></li>
                <li class="breadcrumb-item active" aria-current="page">Notification Hub</li>
            </ol>
        </nav>
        <h1 class="page-title mb-0 d-flex align-items-center gap-2">
            <span class="badge rounded-circle p-2 bg-danger-subtle text-danger"><i class="bi bi-bell-fill fs-5"></i></span>
            Notification Service
            <span class="fs-6 text-muted fw-normal ms-2">Điều phối thông báo đa kênh (Smart Routing)</span>
        </h1>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a class="btn btn-primary d-flex align-items-center gap-2" href="#dispatch-card" id="open-dispatch">
            <i class="bi bi-send-fill"></i>Gửi thông báo
        </a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success alert-dismissible fade show" role="alert" id="flash-message">
        <i class="bi bi-check-circle-fill me-2"></i>@Model.Message
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (!string.IsNullOrEmpty(Model.LoadError))
{
    <div class="alert alert-warning" role="alert" id="load-error"><i class="bi bi-exclamation-triangle me-1"></i>@Model.LoadError</div>
}

<!-- Metrics Bar -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="quick-metric-card">
            <div class="quick-metric-icon bg-danger-subtle text-danger"><i class="bi bi-diagram-3-fill"></i></div>
            <div>
                <div class="quick-metric-val">Smart Route</div>
                <div class="quick-metric-lbl">Chế độ điều phối</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="quick-metric-card">
            <div class="quick-metric-icon bg-primary-subtle text-primary"><i class="bi bi-layout-text-window-reverse"></i></div>
            <div>
                <div class="quick-metric-val" id="metric-templates">@Model.ActiveTemplatesCount</div>
                <div class="quick-metric-lbl">Mẫu thông báo sẵn sàng</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="quick-metric-card">
            <div class="quick-metric-icon bg-success-subtle text-success"><i class="bi bi-check2-circle"></i></div>
            <div>
                <div class="quick-metric-val" id="metric-success">@(Model.SuccessRate is { } rate ? $"{rate}%" : "—")</div>
                <div class="quick-metric-lbl">Tỷ lệ điều phối thành công</div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="quick-metric-card">
            <div class="quick-metric-icon bg-info-subtle text-info"><i class="bi bi-send-check"></i></div>
            <div>
                <div class="quick-metric-val" id="metric-today">@Model.TotalDispatchesToday</div>
                <div class="quick-metric-lbl">Thông báo hôm nay (UTC)</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Templates Table -->
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
                <strong class="d-flex align-items-center gap-2"><i class="bi bi-collection text-primary"></i>Danh mục Mẫu thông báo (Templates)</strong>
                <span class="badge bg-light text-dark border">@Model.Templates.Count mẫu</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="templates-table">
                    <thead class="table-light">
                        <tr>
                            <th>Mã mẫu</th>
                            <th>Tên mẫu &amp; Biến cần điền</th>
                            <th>Kênh</th>
                            <th>Ưu tiên</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Lượt dùng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var tpl in Model.Templates)
                        {
                            <tr data-template="@tpl.Code">
                                <td><code class="fw-bold text-primary">@tpl.Code</code></td>
                                <td>
                                    <div class="fw-semibold text-dark">@tpl.Title</div>
                                    <div class="mt-1">
                                        @foreach (var placeholder in tpl.Placeholders)
                                        {
                                            <span class="badge text-bg-light border me-1"><code>@placeholder</code></span>
                                        }
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary-subtle text-secondary border">@tpl.Channels</span></td>
                                <td><span class="badge @(tpl.Priority is "High" or "Critical" ? "text-bg-warning" : "text-bg-light border")">@tpl.Priority</span></td>
                                <td>
                                    @if (tpl.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle"><i class="bi bi-check-circle-fill me-1"></i>Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Tắt</span>
                                    }
                                </td>
                                <td class="text-end fw-semibold">@tpl.UsageCount</td>
                            </tr>
                        }
                        @if (Model.Templates.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4" id="no-templates">Chưa có mẫu thông báo nào.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Smart Routing Explanation Card -->
    <div class="col-12 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <strong class="d-flex align-items-center gap-2"><i class="bi bi-lightning-charge-fill text-warning"></i>Cơ chế Smart Routing</strong>
            </div>
            <div class="card-body">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item px-0 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle text-success mt-1"></i>
                        <div>
                            <strong>Email, Chat hoặc cả hai:</strong>
                            <div class="text-muted">Mỗi mẫu có kênh mặc định; với "Email + Chat" hai kênh được gửi song song.</div>
                        </div>
                    </li>
                    <li class="list-group-item px-0 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle text-success mt-1"></i>
                        <div>
                            <strong>Dự phòng (High / Critical):</strong>
                            <div class="text-muted">Nếu kênh duy nhất lỗi, hệ thống gửi qua kênh còn lại: email lỗi thì chat nhận bản tóm tắt (tiêu đề và lý do, không có nội dung); chat lỗi thì người nhận được gửi email đầy đủ.</div>
                        </div>
                    </li>
                    <li class="list-group-item px-0 d-flex align-items-start gap-2">
                        <i class="bi bi-check-circle text-success mt-1"></i>
                        <div>
                            <strong>Hàng đợi:</strong>
                            <div class="text-muted">Chọn "Đưa vào hàng đợi" để dịch vụ tự thử lại (1 s, 5 s, 15 s) khi nhà cung cấp gián đoạn.</div>
                        </div>
                    </li>
                </ul>
                <div class="mt-3 p-2 bg-light rounded text-center small text-muted">
                    API Endpoint: <code>POST /api/v1/notifications/dispatch</code>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Dispatch form -->
<form method="post" asp-page-handler="Dispatch" class="card shadow-sm mb-4" id="dispatch-card">
    <div class="card-header bg-transparent"><strong><i class="bi bi-send me-1"></i>Gửi thông báo</strong></div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.FormError))
        {
            <div class="alert alert-danger" role="alert" id="form-error">@Model.FormError</div>
        }
        <div class="row g-3">
            <div class="col-12 col-md-3">
                <label class="form-label" for="Form_ProjectCode">Dự án</label>
                <input class="form-control" id="Form_ProjectCode" name="Form.ProjectCode" value="@Model.Form.ProjectCode" maxlength="50" autocomplete="off" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="Form_TemplateCode">Mẫu thông báo</label>
                <select class="form-select" id="Form_TemplateCode" name="Form.TemplateCode" required>
                    <option value="">— chọn —</option>
                    @foreach (var tpl in Model.Templates.Where(t => t.IsActive))
                    {
                        <option value="@tpl.Code" selected="@(tpl.Code == Model.Form.TemplateCode)">@tpl.Code</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="Form_RecipientEmail">Email người nhận</label>
                <input class="form-control" id="Form_RecipientEmail" name="Form.RecipientEmail" type="email" value="@Model.Form.RecipientEmail" maxlength="254" placeholder="user@example.com" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label" for="Form_RecipientChatId">Chat id (tùy chọn)</label>
                <input class="form-control" id="Form_RecipientChatId" name="Form.RecipientChatId" value="@Model.Form.RecipientChatId" maxlength="200" placeholder="mặc định của cấu hình" />
            </div>
            <div class="col-12">
                <label class="form-label" for="Form_DataText">Giá trị các biến (mỗi dòng <code>Tên=giá trị</code>)</label>
                <textarea class="form-control font-monospace" id="Form_DataText" name="Form.DataText" rows="4" placeholder="UserName=Nguyễn Văn A&#10;ActionUrl=https://app.example.com/verify?token=...">@Model.Form.DataText</textarea>
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="Form_Queue" name="Form.Queue" value="true" checked="@Model.Form.Queue" />
                    <label class="form-check-label" for="Form_Queue">Đưa vào hàng đợi (dịch vụ tự thử lại khi nhà cung cấp gián đoạn)</label>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer bg-transparent">
        <button type="submit" class="btn btn-primary" id="dispatch-button"><i class="bi bi-send-fill me-1"></i>Gửi</button>
    </div>
</form>

<!-- Recent Dispatch Log -->
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex align-items-center justify-content-between py-3">
        <strong class="d-flex align-items-center gap-2"><i class="bi bi-activity text-info"></i>Lịch sử Điều phối Gần đây</strong>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="dispatch-table">
            <thead class="table-light">
                <tr>
                    <th>Mẫu</th>
                    <th>Dự án</th>
                    <th>Người nhận</th>
                    <th>Kênh điều phối</th>
                    <th>Độ trễ</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thời gian</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model.RecentDispatches)
                {
                    <tr data-status="@log.Status">
                        <td><code>@log.EventType</code></td>
                        <td>@log.Project</td>
                        <td class="fw-semibold">@log.Recipient</td>
                        <td><span class="badge bg-info-subtle text-info border">@log.ChannelUsed</span></td>
                        <td><code>@log.LatencyMs ms</code></td>
                        <td>
                            <span class="badge @(log.Status switch { "Sent" => "text-bg-success", "Queued" => "text-bg-info", "Failed" => "text-bg-danger", _ => "text-bg-warning" })">@(log.Status switch
                            {
                                "Sent" => "Thành công",
                                "Queued" => "Trong hàng đợi",
                                "Fallback" => "Qua kênh dự phòng",
                                "Partial" => "Một phần",
                                _ => "Thất bại",
                            })</span>
                        </td>
                        <td class="text-end text-muted small">@UiHelpers.FormatRelativeTime(log.DispatchedAt)</td>
                    </tr>
                }
                @if (Model.RecentDispatches.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4" id="no-dispatches">Chưa có thông báo nào được gửi.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
