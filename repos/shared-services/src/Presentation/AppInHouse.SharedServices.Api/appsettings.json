{
  "ConnectionStrings": {
    "SharedServicesDb": "Data Source=data/shared-services.db"
  },
  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": false
  },
  "DataProtection": {
    "ApplicationName": "AppInHouse.SharedServices",
    "KeysPath": "data/dp-keys"
  },
  "Authentication": {
    "Authority": "",
    "ClientId": "shared_services_api",
    "ClientSecret": "",
    "Audience": "shared_services_api"
  },
  "Email": {
    "AllowPrivateNetworkHosts": false,
    "SmtpTimeoutSeconds": 20,
    "SendGridBaseUrl": "https://api.sendgrid.com",
    "SendGridTimeoutSeconds": 20
  },
  "Swagger": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
