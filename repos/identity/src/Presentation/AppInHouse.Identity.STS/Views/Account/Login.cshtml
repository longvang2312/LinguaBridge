@model LoginViewModel
@{
    ViewData["Title"] = "Sign in";
}

<h1>Sign in</h1>

<form method="post" asp-action="Login">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly" class="error"></div>

    <label asp-for="Email"></label>
    <input asp-for="Email" autocomplete="username" autofocus />
    <span asp-validation-for="Email" class="error"></span>

    <label asp-for="Password"></label>
    <input asp-for="Password" autocomplete="current-password" />
    <span asp-validation-for="Password" class="error"></span>

    <label><input asp-for="RememberMe" /> Remember me</label>

    <button type="submit">Sign in</button>
</form>
