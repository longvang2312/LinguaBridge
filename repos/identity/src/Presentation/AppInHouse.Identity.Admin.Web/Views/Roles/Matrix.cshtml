@model RoleMatrixViewModel
@{
    ViewData["Title"] = "Role matrix";
    var moduleIndex = 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Role matrix</h1>
    <a class="btn btn-outline-primary" asp-controller="Permissions" asp-action="Create">New permission</a>
</div>
<p class="text-muted">Tick the permissions each role carries. Saving a role applies at once to everybody who holds it, in every project. GlobalAdmin is not listed: it always has every right.</p>

<form asp-action="Matrix" method="post">
    @foreach (var role in Model.Roles)
    {
        <input type="hidden" name="roleIds" value="@role.Id" />
    }
    <div class="card">
        <div class="table-responsive">
            <table class="table table-sm table-hover mb-0 matrix">
                <thead>
                    <tr>
                        <th>Permission</th>
                        @foreach (var role in Model.Roles) { <th scope="col">@role.Name</th> }
                    </tr>
                </thead>
                <tbody>
                @foreach (var module in Model.Modules)
                {
                    moduleIndex++;
                    <tr class="module-row">
                        <th scope="rowgroup">@module.Key</th>
                        @foreach (var role in Model.Roles)
                        {
                            <th><input class="form-check-input" type="checkbox" data-toggle-group="m@(moduleIndex)-@role.Id" aria-label="Toggle every @module.Key permission for @role.Name" /></th>
                        }
                    </tr>
                    @foreach (var permission in module.OrderBy(p => p.PermissionCode))
                    {
                        <tr>
                            <td>
                                <code>@permission.PermissionCode</code>
                                <span class="text-muted small">@permission.DisplayName</span>
                                @if (!permission.IsGlobal) { <span class="badge text-bg-light">project</span> }
                            </td>
                            @foreach (var role in Model.Roles)
                            {
                                <td>
                                    <input class="form-check-input" type="checkbox" name="cells" value="@role.Id|@permission.Id"
                                           data-group="m@(moduleIndex)-@role.Id"
                                           checked="@Model.Holds(role, permission)"
                                           aria-label="@role.Name has @permission.PermissionCode" />
                                </td>
                            }
                        </tr>
                    }
                }
                @if (!Model.Permissions.Any())
                {
                    <tr><td colspan="@(Model.Roles.Count + 1)" class="text-muted">No permission is defined yet.</td></tr>
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">Save matrix</button></div>
    </div>
</form>
