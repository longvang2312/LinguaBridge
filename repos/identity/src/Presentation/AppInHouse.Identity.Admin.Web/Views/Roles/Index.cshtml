@model RoleListViewModel
@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Roles</h1>
    @if (Model.IsGlobalAdmin)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-outline-primary" asp-action="Matrix">Role matrix</a>
            <a class="btn btn-primary" asp-action="Create">New role</a>
        </div>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6"><input class="form-control" name="Search" value="@Model.Query.Search" placeholder="Search by name" maxlength="100" /></div>
    <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">Filter</button></div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Name</th><th>Description</th>@if (Model.IsGlobalAdmin) { <th>Permissions</th> }<th></th></tr></thead>
            <tbody>
            @foreach (var role in Model.Items)
            {
                <tr>
                    <td>@role.Name</td>
                    <td>@role.Description</td>
                    @if (Model.IsGlobalAdmin)
                    {
                        <td class="small">@(role.Permissions is { Count: > 0 } permissions ? string.Join(", ", permissions.Select(p => p.PermissionCode)) : "-")</td>
                    }
                    <td class="text-end">@if (Model.IsGlobalAdmin) { <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@role.Id">Edit</a> }</td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="4" class="text-muted">No role found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="mt-3"><partial name="_Pager" model="Model.Pager" /></div>
