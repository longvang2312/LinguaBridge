@using AppInHouse.Identity.Application.Admin.Projects
@model CreateProjectRequest
@{
    ViewData["Title"] = "New project";
}

<h1 class="h3 mb-3">New project</h1>
<form asp-action="Create" method="post" class="card card-body" style="max-width: 40rem">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="ProjectCode" class="form-label"></label>
        <input asp-for="ProjectCode" class="form-control" autocomplete="off" />
        <span asp-validation-for="ProjectCode" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Create</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
