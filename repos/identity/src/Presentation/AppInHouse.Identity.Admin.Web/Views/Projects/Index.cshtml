@model ProjectListViewModel
@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Projects</h1>
    @if (Model.CanCreate)
    {
        <a class="btn btn-primary" asp-action="Create">New project</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input class="form-control" name="Search" value="@Model.Query.Search" placeholder="Search by code or name" maxlength="100" /></div>
    <div class="col-md-3">
        <select class="form-select" name="IsActive">
            <option value="" selected="@(Model.Query.IsActive is null)">Any status</option>
            <option value="true" selected="@(Model.Query.IsActive == true)">Active</option>
            <option value="false" selected="@(Model.Query.IsActive == false)">Locked</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">Filter</button></div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Code</th><th>Name</th><th>Status</th><th>Created (UTC)</th><th></th></tr></thead>
            <tbody>
            @foreach (var project in Model.Items)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@project.Id">@project.ProjectCode</a></td>
                    <td>@project.Name</td>
                    <td>@if (project.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-warning">Locked</span> }</td>
                    <td>@project.CreatedAt.ToString("yyyy-MM-dd")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@project.Id">Members</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@project.Id">Edit</a>
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">No project found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="mt-3"><partial name="_Pager" model="Model.Pager" /></div>
