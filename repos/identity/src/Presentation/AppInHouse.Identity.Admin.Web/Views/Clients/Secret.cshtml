@model ClientSecretViewModel
@{
    ViewData["Title"] = "Client secret";
}

<h1 class="h3 mb-3">@(Model.Rotated ? "New secret" : "Client created") for <code>@Model.ClientId</code></h1>
<div class="alert alert-warning">
    Copy the secret now. It is shown <strong>only once</strong>: only a hash is stored and it cannot be displayed again.
</div>
<div class="card card-body secret-box mb-3" style="max-width: 50rem" data-secret>@Model.Secret</div>
<a class="btn btn-primary" asp-action="Index">I have stored it</a>
