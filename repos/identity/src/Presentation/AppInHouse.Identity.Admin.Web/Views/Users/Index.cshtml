@model UserListViewModel
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 m-0">Users</h1>
    <a class="btn btn-primary" asp-action="Create">New user</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input class="form-control" name="Search" value="@Model.Query.Search" placeholder="Search by email or name" maxlength="100" /></div>
    <div class="col-md-3">
        <select class="form-select" name="IsActive">
            <option value="" selected="@(Model.Query.IsActive is null)">Any status</option>
            <option value="true" selected="@(Model.Query.IsActive == true)">Active</option>
            <option value="false" selected="@(Model.Query.IsActive == false)">Inactive</option>
        </select>
    </div>
    <div class="col-auto"><button class="btn btn-outline-secondary" type="submit">Filter</button></div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>Email</th><th>Name</th><th>Status</th><th>Last sign-in (UTC)</th><th></th></tr></thead>
            <tbody>
            @foreach (var user in Model.Items)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@user.Id">@user.Email</a></td>
                    <td>@user.FullName</td>
                    <td>
                        @if (!user.IsActive) { <span class="badge text-bg-secondary">Inactive</span> }
                        else if (user.IsLockedOut) { <span class="badge text-bg-danger">Locked</span> }
                        else { <span class="badge text-bg-success">Active</span> }
                    </td>
                    <td>@(user.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@user.Id">Manage</a></td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="5" class="text-muted">No user found.</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="mt-3"><partial name="_Pager" model="Model.Pager" /></div>
