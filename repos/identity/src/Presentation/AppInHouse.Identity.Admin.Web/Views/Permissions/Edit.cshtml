@model PermissionFormViewModel
@{
    ViewData["Title"] = "Edit permission";
}

<h1 class="h3 mb-3">Edit permission <code>@Model.Form.PermissionCode</code></h1>
<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="card card-body" style="max-width: 40rem">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label" for="DisplayName">Display name</label>
        <input class="form-control" id="DisplayName" name="DisplayName" value="@Model.Form.DisplayName" maxlength="150" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="Module">Module</label>
        <input class="form-control" id="Module" name="Module" value="@Model.Form.Module" maxlength="50" required />
    </div>
    <div class="mb-3">
        <label class="form-label" for="IsActive">Status</label>
        <select class="form-select" id="IsActive" name="IsActive">
            <option value="true" selected="@Model.IsActive">Active</option>
            <option value="false" selected="@(!Model.IsActive)">Inactive</option>
        </select>
        <div class="form-text">Deactivating a permission removes it from everybody who holds it, immediately.</div>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-link" asp-action="Index">Cancel</a>
    </div>
</form>
