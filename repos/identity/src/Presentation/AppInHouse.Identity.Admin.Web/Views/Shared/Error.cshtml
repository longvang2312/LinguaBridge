@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="h3 text-danger">Something went wrong</h1>
<p>The request could not be completed. Nothing was shown to you on purpose: details are in the server log.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}
